{
  "name": "size-sensor",
  "version": "1.0.3",
  "description": "DOM element size sensor which will callback when size changed.",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "scripts": {
    "debug": "playwright test --debug",
    "test": "npm run build:test && playwright test && npm run coverage:report",
    "test:only": "npm run build:test && playwright test",
    "coverage:report": "nyc report --reporter=html --reporter=text --reporter=lcov",
    "build:test": "cross-env NODE_ENV=rollup rollup -c rollup.config.test.js",
    "build:umd": "rimraf ./dist && cross-env NODE_ENV=rollup rollup -c",
    "build:lib": "rimraf ./lib && cross-env NODE_ENV=babel babel src -d lib",
    "build": "npm run build:umd && npm run build:lib && limit-size"
  },
  "limit-size": [
    {
      "limit": "1 KB",
      "path": "dist/size-sensor.min.js",
      "gzip": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hustcc/size-sensor.git"
  },
  "keywords": [
    "resize",
    "size",
    "sensor",
    "size-detector",
    "element"
  ],
  "devDependencies": {
    "@babel/cli": "^7.6.0",
    "@babel/core": "^7.6.0",
    "@babel/preset-env": "^7.6.0",
    "@playwright/test": "^1.58.0",
    "babel-plugin-version": "^0.2.1",
    "cross-env": "^5.1.3",
    "limit-size": "^0.1.2",
    "nyc": "^17.1.0",
    "rimraf": "^2.6.2",
    "rollup": "^1.21.4",
    "rollup-plugin-babel": "^4.3.3",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-uglify": "^6.0.3",
    "v8-to-istanbul": "^9.3.0"
  },
  "nyc": {
    "report-dir": "./coverage",
    "temp-dir": "./coverage/tmp",
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "tests/**/*",
      "node_modules/**/*"
    ],
    "all": true
  },
  "author": "hustcc",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hustcc/size-sensor/issues"
  },
  "homepage": "https://git.hust.cc/size-sensor"
}
